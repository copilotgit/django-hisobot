# Copy this file to .env next to manage.py and fill it in.
# .env holds secrets - never commit it (it is in .gitignore).

# Your university's HEMIS REST API address and its API token (ask your HEMIS administrator)
HEMIS_API_URL=https://student.example.uz/rest/v1/data/
HEMIS_API_TOKEN=

# --- optional ---
# Ask users to log in before they see the report (true / false)
HISOBOT_LOGIN_REQUIRED=false
# Refresh in the background when the page is opened and the data is older than
# this many hours (0 = only with the button or `python manage.py hisobot_refresh`)
HISOBOT_AUTO_REFRESH_HOURS=0
# Where the downloaded report is kept (default: <BASE_DIR>/hisobot_data.json)
# HISOBOT_DATA_FILE=/var/lib/hisobot/hisobot_data.json
# Parallel requests to HEMIS (keep it low - HEMIS rate-limits)
HISOBOT_WORKERS=3
# Your time zone, hours from UTC (Tashkent = 5)
HISOBOT_UTC_OFFSET=5
